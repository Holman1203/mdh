# Get a free access key at https://web3forms.com (enter mamrexhub@gmail.com)
# Copy this file to .env.local and replace the placeholder.
NEXT_PUBLIC_WEB3FORMS_KEY=YOUR_WEB3FORMS_ACCESS_KEY

# Your live site address (used for sitemap, Open Graph and schema)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Mamrex Learn (free courses). Create a free project at https://supabase.com, then paste the two values from
# Project Settings -> API. Run supabase/schema.sql once in the SQL Editor. Leave blank to run in preview mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
